# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./data/otz.db

# === Storage ===
DATA_DIR=./data
INBOUND_PHOTOS_DIR=./data/inbound
LISTINGS_PHOTOS_DIR=./data/listings

# === Telegram (Telethon — reading source channels) ===
# Get from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_SESSION_NAME=otz_monitor
TG_PHONE=
# OTZ_2FA / OTZ_SESSION — НЕ ставить в .env. Только как inline-env для разовой
# QR-реавторизации: `OTZ_SESSION=otz_logger OTZ_2FA=<пароль> .venv/bin/python scripts/auth_qr.py`
# (см. HANDOFF §5.4). 2FA-пароль в файле хранить не нужно.

# Delivery mode: "bot" (recommended) or "userbot" (legacy)
TG_DELIVERY_MODE=bot
TG_BOT_TOKEN=
# Comma-separated chat_ids. Each user must /start the bot first; read their IDs from
#   curl "https://api.telegram.org/bot<TG_BOT_TOKEN>/getUpdates"
# then verify delivery reaches everyone with:
#   .venv/bin/python -m src.cli daily-summary
TG_BOT_RECIPIENTS=

# Legacy userbot fallback (TG_DELIVERY_MODE=userbot)
TG_DELIVERY_TARGET=Darya_kralj

# Publication target — informational only, we never post to the channel ourselves
TG_TARGET_CHANNEL=@RentBelgrad

# === Scrapers ===
# Reserved, currently unused — no code reads these yet (scheduling lives in systemd timers)
SCRAPE_LIST_INTERVAL_MIN=30
SCRAPE_RECHECK_INTERVAL_HOURS=6
SCRAPER_USER_AGENT=
# Optional Webshare/Bright Data proxy for halooglasi
SCRAPER_PROXY_URL=

# === Live-smoke probe (A2 — markup-change protection) ===
# A healthy list page must yield >= this many previews (mirrors Scraper.MIN_PREVIEWS).
SCRAPE_SMOKE_MIN_PREVIEWS=5
# Kill switch: SCRAPE_SMOKE_ENABLED=0 → the scrape-smoke command no-ops.
SCRAPE_SMOKE_ENABLED=true
# B1 — nightly per-parser parse-success-rate degradation guard. Alert when
# parse_rate (details_parsed_ok/details_attempted) < PARSE_RATE_MIN AND the sample is big enough
# (details_attempted >= PARSE_RATE_MIN_SAMPLE) — don't cry wolf on tiny samples.
PARSE_RATE_MIN=0.7
PARSE_RATE_MIN_SAMPLE=10

# === Nightly maintenance steps (nightly-refresh) ===
# Each step can be disabled with =0. A failing step adds a 🚨 line to the nightly
# telegram summary but never aborts the nightly itself (only the base scrape is fatal).
# Max broken rows (active listings with no photo hashes) to auto-heal per night. 0 = skip.
NIGHTLY_HEAL_LIMIT=500
# Active listings to re-fetch details for per night (stale prices), split evenly across
# platforms, oldest details_refreshed_at first (never-refreshed NULLs first). 0 = skip.
NIGHTLY_DETAIL_REFRESH=200
# Null out photo_embeddings of listings inactive >30 days. Frees pages inside otz.db;
# the file itself shrinks only after a MANUAL VACUUM (backup + stopped monitor — see
# docs/PHASE5_DEPLOY.md §9). 0 = skip.
NIGHTLY_PRUNE_EMBEDDINGS=1
# Daily per-platform snapshot into daily_metrics + 🚨 alert when a platform's
# active_count drops >20% in a day (guards against "scraper died, sweep killed all"). 0 = skip.
NIGHTLY_METRICS=1
# A3 liveness sweep: HEAD-check active matched listings (potentially on the site) and deactivate
# ones that 404/410, so a public card never links to a removed page. 0 = skip.
NIGHTLY_VERIFY_LINKS=1
# Cap listings HEAD-checked per night by the liveness sweep.
NIGHTLY_VERIFY_LINKS_LIMIT=1000
# X1 auto-publish (delivery hot path): when a match is delivered (PENDING→PUBLISHED), auto-expose
# its card on the site. AUTO_PUBLISH_ON_SEND=0 → revert to manual curation (runtime kill switch).
AUTO_PUBLISH_ON_SEND=1
# X1 auto-publish (nightly backfill): expose any delivered-but-not-yet-exposed matches. 0 = skip.
NIGHTLY_AUTO_PUBLISH=1
# X2 auto-remove: when verify-links deactivates a platform-removed listing (404/410), auto-hide its
# public card in the SAME transaction. NIGHTLY_AUTO_HIDE_SITE_LISTINGS=0 → skip.
NIGHTLY_AUTO_HIDE_SITE_LISTINGS=1
# Liveness sweep (replaces the age-based 21-day retention notice). A public card stays up while the
# apartment is listed on >= 1 platform (its A4 dup-group) and only comes down when confirmed gone
# from ALL. SITE_LIVENESS_ENABLED=0 → skip the nightly step entirely.
SITE_LIVENESS_ENABLED=1
# Warn-first: 0 = notice-only (list confirmed-dead candidates, hide nothing). Flip to 1 on the
# server only after ~a week of clean notices.
SITE_LIVENESS_AUTO_HIDE=0
# Safety cap on auto-hides per night (overflow → notice candidates, not hidden).
SITE_LIVENESS_MAX_HIDES=10
# C2 nightly saved-search digest: new public listings × active subscriptions → notices (idempotent
# via subscription_matches). NIGHTLY_NOTIFY_SUBSCRIPTIONS=0 → skip the step.
NIGHTLY_NOTIFY_SUBSCRIPTIONS=1
# Only listings created within this window are digest candidates (a fresh subscription isn't blasted
# with the whole back-catalog; subscription_matches still guards against re-sends).
SUBSCRIPTION_NOTIFY_SINCE_HOURS=24
# Wall-clock budget (seconds) SHARED by heal + rolling detail-refresh: once it runs out both
# stop and report "пропущено по бюджету: N", so a night of slow Cloudflare-challenged refetches
# can't overrun (guards the 2026-06-16 SIGTERM). Default 7200 = 2h.
NIGHTLY_REFETCH_BUDGET_SEC=7200
# Per-listing hard cap (seconds) on a single detail fetch — one pathological page (goto +
# content-poll × retries + browser recycle) is forced to fail instead of burning minutes.
REFETCH_PER_FETCH_TIMEOUT_SEC=90
# Price-drop alerts (nightly-refresh): when the rolling detail refresh sees a listing that has
# a PENDING/PUBLISHED match drop in price by ≥ PRICE_DROP_MIN_PCT percent, recipients get a
# standalone «📉 Цена снизилась» message. PRICE_DROP_ALERTS=0 → off.
PRICE_DROP_ALERTS=true
PRICE_DROP_MIN_PCT=5

# === Source channels ===
# ISO date — earliest source-channel message to backfill when a source has no watermark
SOURCE_DEFAULT_START_DATE=2026-05-15

# === Source URLs (configurable filters) ===
NEKRETNINE_LIST_URL=https://www.nekretnine.rs/izdavanje-stanova/beograd/
CETIRI_ZIDA_LIST_URL=https://www.4zida.rs/izdavanje-stanova/beograd
HALOOGLASI_LIST_URL=https://www.halooglasi.com/nekretnine/izdavanje-stanova/beograd
# E1 — cityexpert.rs JSON API (fourth platform). LIST_URL is the human-facing rentals page (used as
# a base / Referer); the scraper actually paginates GET /api/Search?req=<json> against API_BASE.
CITYEXPERT_LIST_URL=https://cityexpert.rs/izdavanje-nekretnina/beograd
CITYEXPERT_API_BASE=https://cityexpert.rs
CITYEXPERT_CITY_ID=1
CITYEXPERT_RESULTS_PER_PAGE=12

# === Matching thresholds ===
PHASH_MAX_HAMMING=6
MIN_MATCHED_PHOTOS=2
# A4 — cross-platform listing dedup (periodic batch job, NOT the per-inbound hot path). Two active
# listings are the SAME apartment when they share >= DEDUP_MIN_SHARED_PHOTOS photos whose pHash
# Hamming distance <= DEDUP_MAX_HAMMING. min=2 on purpose (a single shared photo is too weak —
# agency/stock photos get reused across unrelated listings).
DEDUP_MAX_HAMMING=6
DEDUP_MIN_SHARED_PHOTOS=2
# D2 — nightly dupes step tags dup_group_id/is_primary (not just report). The liveness sweep needs
# live dup-groups to tell a card is still alive on another platform. NIGHTLY_DUPES_WRITE=0 →
# report-only (pre-liveness behaviour).
NIGHTLY_DUPES_WRITE=1
AREA_TOLERANCE_M2=5.0
PRICE_TOLERANCE_EUR=0
CLIP_SIMILARITY_THRESHOLD=0.92
ENABLE_CLIP_FALLBACK=true
# Drop a CLIP candidate when parsed price/area diverge from the listing by more than this fraction
CROSS_CHECK_PRICE_TOLERANCE_PCT=0.25
CROSS_CHECK_AREA_TOLERANCE_PCT=0.20

# Claude API LLM validator (vision-based duplicate check). Optional but recommended.
# Get key at https://console.anthropic.com. Costs ~$0.01 per validated candidate.
ANTHROPIC_API_KEY=
ENABLE_LLM_VALIDATION=true
LLM_VALIDATION_MIN_CONFIDENCE=0.7

# === Web admin ===
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8000
ADMIN_USERNAME=darya
ADMIN_PASSWORD=change_me

# === Telemetry ===
# When true, every no_match inbound pings a one-line summary into the logger userbot's
# Saved Messages (otz_logger.session) so silence ≠ dead pipeline.
NOTIFY_NO_MATCH_ENABLED=true

# === Misc ===
LOG_LEVEL=INFO
TIMEZONE=Europe/Belgrade

# === Stage W — Public Web Catalog (otz-site.service, behind Caddy) ===
# Also add these to /opt/otz/.env on the server by hand (.env is not synced by deploy_sync.sh).
# Public app binding (exposed externally only via Caddy, see deploy/Caddyfile)
SITE_BIND_HOST=127.0.0.1
SITE_BIND_PORT=8001
# Public base URL (OpenGraph, absolute/canonical links)
SITE_PUBLIC_BASE_URL=https://rent.example.com
# Catalog/facets/map cache, seconds
SITE_CACHE_TTL=300
# Catalog page size
SITE_PAGE_SIZE=24
# Public photos root on disk (served by Caddy as /photos/*); must equal Caddy's /photos root.
# = where the pipeline downloads inbound photos (InboundPost.photo_paths = "data/inbound/...").
SITE_PHOTOS_ROOT=/opt/otz/data/inbound
# Default channel link when a listing has no channel_post_url
SITE_CHANNEL_URL=https://t.me/RentBelgrad
# Lead form rate-limit: max submissions per IP per window (sec)
SITE_LEAD_RATELIMIT_MAX=5
SITE_LEAD_RATELIMIT_WINDOW=3600
# (new-lead notice goes to Даря via the already-configured bot — reuses TG_BOT_TOKEN / TG_BOT_RECIPIENTS)

# === Stage W2 — Conversion & Polish ===
# F5 — permanent "Написать в Telegram" CTA → Дарья's DM
SITE_TELEGRAM_URL=https://t.me/Darya_kralj
# C2 — subscription linking bot username (WITHOUT leading @), used to build the deep-link
# https://t.me/<username>?start=sub_<token>. EMPTY → the Telegram channel is unavailable in the
# subscribe form (only e-mail offered). Set to the @username of the bot whose token is TG_BOT_TOKEN.
SITE_TELEGRAM_BOT_USERNAME=
# C2 — the subscription linking daemon (otz subscription-bot) is a NEW long-running aiogram poller
# listening for /start sub_<token>. OFF by default (enabling needs its own systemd unit). With it
# off, e-mail subscriptions work fully; Telegram ones stay unlinked/inactive until the daemon runs.
SUBSCRIPTION_BOT_ENABLED=false
# F4 — lead-form submissions e-mailed here (also add on the server by hand)
SITE_LEAD_EMAIL_TO=d.mashukova@bk.ru
# F4 — SMTP relay (relay-agnostic; fill real creds in the server .env at deploy — a transactional
# relay or own-domain mail with SPF/DKIM, else bk.ru drops to spam; FROM must NOT be @bk.ru unauthenticated)
SITE_SMTP_HOST=
SITE_SMTP_PORT=587
SITE_SMTP_USER=
SITE_SMTP_PASSWORD=
SITE_SMTP_FROM=no-reply@rentbelgrad.com
SITE_SMTP_STARTTLS=true

# === Stage S — Showcase & Shield ===
# S3-3: trust the CF-Connecting-IP header for the REAL client IP (rate-limit /lead+/subscribe,
# admin G2 lockout). Turn ON (=1) ONLY after the origin is locked to Cloudflare IPs
# (scripts/cf_ufw_allowlist.sh), else the header is spoofable by a direct origin hit. Default off
# preserves the pre-CF behavior (rightmost X-Forwarded-For from Caddy → peer). See deploy/cloudflare/RUNBOOK.md.
TRUST_CLOUDFLARE=0

# === Stage T «Insight & Integrity» — server-side analytics ===
# Also add these to /opt/otz/.env on the server by hand at deploy (Wave 6, step 4).

# Kill-switch аналитики: false → все хуки записи no-op (полный откат без деплоя). Глушит и
# nightly-шаг rollup/retention (см. src/cli.py::_analytics_nightly_line).
SITE_ANALYTICS_ENABLED=true

# Секрет суточной соли visitor-хэша (ДВУХСТУПЕНЧАТО):
#   daily_salt = sha256(SITE_ANALYTICS_SALT‖YYYY-MM-DD)  (hex-digest)
#   visitor    = sha256(daily_salt‖ip‖ua)[:16]
# Пустая соль при включённой аналитике → fail-closed (события не пишутся, один warn на процесс).
# Сгенерировать НА СЕРВЕРЕ: openssl rand -hex 32
# НИКОГДА не коммитить; в .env.example оставить пустым.
SITE_ANALYTICS_SALT=

# Ретеншн сырых событий (агрегаты site_stats_daily хранятся вечно)
SITE_ANALYTICS_RAW_RETENTION_DAYS=90
