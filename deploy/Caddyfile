# Caddyfile — публичный сайт rentbelgrad.com (Stage W). ЭТО БОЕВОЙ КОНФИГ (развёрнут 20.06.2026).
# Лежит в /etc/caddy/Caddyfile на VPS. Caddy сам выпускает/продлевает TLS (Let's Encrypt):
# нужны DNS A-записи rentbelgrad.com + www.rentbelgrad.com -> 90.156.254.159 и открытые 80/443 (ufw).
# admin.rentbelgrad.com -> внутренняя админка (:8000) за HTTP Basic-auth (ADMIN_USERNAME/ADMIN_PASSWORD);
# требует DNS A-записи admin.rentbelgrad.com -> 90.156.254.159 (иначе Caddy не выпустит TLS). После правок: systemctl reload caddy.
#
# ─── Stage S Wave 3 (Cloudflare) ────────────────────────────────────────────────────────────────
# Когда сайт встанет за Cloudflare (proxied/оранжевое облако), публичный ACME HTTP-01 ломается
# (CF терминирует TLS на edge), поэтому проксируемые хосты переходят на **Origin CA cert** + CF SSL
# mode = Full(Strict). Шаги — `deploy/cloudflare/RUNBOOK.md`. В этом файле строки `tls …` под каждым
# проксируемым хостом ПОДГОТОВЛЕНЫ и ЗАКОММЕНТИРОВАНЫ — раскомментировать в шаге 3b-1 (S3-1).
# CF-Connecting-IP: Caddy `reverse_proxy` форвардит все заголовки на бэкенд по умолчанию, поэтому
# приложение видит `CF-Connecting-IP` как есть (читает его при `TRUST_CLOUDFLARE=1`, S3-3) — спец.
# конфиг Caddy для этого НЕ нужен. (Опц. для корректного XFF-лога самого Caddy можно добавить
# `trusted_proxies` с CF-диапазонами — см. RUNBOOK; на работу rate-limit приложения не влияет.)

www.rentbelgrad.com {
    redir https://rentbelgrad.com{uri} permanent
}

# Внутренняя админка Дарьи: публикация квартир на сайт («На сайт»/«Mark-posted»), очередь, метрики.
# Аутентификация — на стороне приложения (HTTP Basic, fail-closed на дефолтном пароле). Caddy лишь
# проксирует всё на otz-admin.service (:8000) и добавляет HTTPS + anti-clickjacking-заголовки.
# CSP не ставим: админка тянет HTMX с unpkg и Chart.js с jsdelivr, а доступ и так за логином.
admin.rentbelgrad.com {
    # Stage S Wave 3b (S3-1): за Cloudflare раскомментировать — Origin CA cert вместо ACME.
    # tls /etc/caddy/origin/rentbelgrad.pem /etc/caddy/origin/rentbelgrad.key
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

rentbelgrad.com {

    # Stage S Wave 3b (S3-1): за Cloudflare раскомментировать — Origin CA cert (wildcard покрывает
    # и admin.*), CF SSL mode = Full(Strict). Снимает зависимость от ACME HTTP-01 (ломается под CF).
    # tls /etc/caddy/origin/rentbelgrad.pem /etc/caddy/origin/rentbelgrad.key

    encode zstd gzip

    # Статика и фото — отдаёт сам Caddy с диска, мимо Python (быстро, far-future cache).
    handle_path /static/* {
        root * /opt/otz/src/site/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }
    handle_path /photos/* {
        # photos_root = куда пайплайн качает фото. public_photo_url отдаёт /photos/<relpath-под-root>,
        # поэтому root ДОЛЖЕН совпадать с SITE_PHOTOS_ROOT. Заперт в data/inbound (НЕ /opt/otz),
        # чтобы .env / otz.db нельзя было отдать через /photos.
        root * /opt/otz/data/inbound
        # photo_manifest.json живёт в РОДИТЕЛЕ photos_root (/opt/otz/data) и сюда не попадает
        # (ревью Wave 5: манифест индексирует ВСЕ inbound-фото, включая неопубликованные).
        # hide — belt & suspenders на случай, если он снова окажется внутри; глоб без пути
        # прячет имя в ЛЮБОМ каталоге и ловит также .lock/.tmp-огрызки.
        file_server {
            hide photo_manifest.json*
        }
        # T4-3: far-future+immutable — оригиналы контент-стабильны (relpath уникален per-фото),
        # webp-варианты derived от оригинала; смена контента = новый relpath, не перезапись.
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # Всё остальное — в публичное FastAPI-приложение (otz-site.service).
    handle {
        reverse_proxy 127.0.0.1:8001
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # CSP: в script-src 'unsafe-inline' БОЛЬШЕ НЕ НУЖЕН — T4-4 вынес все inline-обработчики
        # (onchange sort/subscribe-radio, onerror фото-фоллбэков) в static/js; e2e-гард
        # tests/e2e/site/test_no_inline_js.py держит ноль on*-атрибутов на публичных страницах.
        # ГОТОВО К СНЯТИЮ на деплое Wave 6 при зелёном smoke: убрать 'unsafe-inline' ТОЛЬКО из
        # script-src (style-src оставить — inline style="" в дизайне остаётся).
        # jsdelivr отдаёт Leaflet (script+css), https:/data: — тайлы OSM + маркеры + SVG-favicon;
        # остальное same-origin. frame-ancestors/base-uri/form-action — защита от clickjacking и т.п.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Access-log в файл требует systemd ReadWritePaths drop-in (sandbox юнита caddy блокирует
    # запись в /var/log/otz). Пока — рантайм/ошибки в journald: journalctl -u caddy.
}
