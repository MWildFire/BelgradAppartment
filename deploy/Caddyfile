# Caddyfile — публичный сайт rentbelgrad.com (Stage W). ЭТО БОЕВОЙ КОНФИГ (развёрнут 20.06.2026).
# Лежит в /etc/caddy/Caddyfile на VPS. Caddy сам выпускает/продлевает TLS (Let's Encrypt):
# нужны DNS A-записи rentbelgrad.com + www.rentbelgrad.com -> 90.156.254.159 и открытые 80/443 (ufw).
# admin.rentbelgrad.com -> внутренняя админка (:8000) за HTTP Basic-auth (ADMIN_USERNAME/ADMIN_PASSWORD);
# требует DNS A-записи admin.rentbelgrad.com -> 90.156.254.159 (иначе Caddy не выпустит TLS). После правок: systemctl reload caddy.

www.rentbelgrad.com {
    redir https://rentbelgrad.com{uri} permanent
}

# Внутренняя админка Дарьи: публикация квартир на сайт («На сайт»/«Mark-posted»), очередь, метрики.
# Аутентификация — на стороне приложения (HTTP Basic, fail-closed на дефолтном пароле). Caddy лишь
# проксирует всё на otz-admin.service (:8000) и добавляет HTTPS + anti-clickjacking-заголовки.
# CSP не ставим: админка тянет HTMX с unpkg и Chart.js с jsdelivr, а доступ и так за логином.
admin.rentbelgrad.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
}

rentbelgrad.com {

    encode zstd gzip

    # Статика и фото — отдаёт сам Caddy с диска, мимо Python (быстро, far-future cache).
    handle_path /static/* {
        root * /opt/otz/src/site/static
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }
    handle_path /photos/* {
        # photos_root = куда пайплайн качает фото. public_photo_url отдаёт /photos/<relpath-под-root>,
        # поэтому root ДОЛЖЕН совпадать с SITE_PHOTOS_ROOT. Заперт в data/inbound (НЕ /opt/otz),
        # чтобы .env / otz.db нельзя было отдать через /photos.
        root * /opt/otz/data/inbound
        file_server
        header Cache-Control "public, max-age=604800"
    }

    # Всё остальное — в публичное FastAPI-приложение (otz-site.service).
    handle {
        reverse_proxy 127.0.0.1:8001
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # CSP: 'unsafe-inline' нужен из-за inline style="" в дизайне + одного inline onchange;
        # jsdelivr отдаёт Leaflet (script+css), https:/data: — тайлы OSM + маркеры + SVG-favicon;
        # остальное same-origin. frame-ancestors/base-uri/form-action — защита от clickjacking и т.п.
        # Follow-up: вынести inline onchange в filters.js, тогда script-src сможет убрать 'unsafe-inline'.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    # Access-log в файл требует systemd ReadWritePaths drop-in (sandbox юнита caddy блокирует
    # запись в /var/log/otz). Пока — рантайм/ошибки в journald: journalctl -u caddy.
}
