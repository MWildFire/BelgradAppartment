# Caddyfile — публичный сайт @RentBelgrad (Stage W)
# Положить в /etc/caddy/Caddyfile на VPS, заменить DOMAIN и пути, затем: systemctl reload caddy
# Caddy сам выпустит и продлит TLS через Let's Encrypt (нужна DNS A-запись DOMAIN -> 90.156.254.159
# и открытые порты 80/443 в ufw). Админка (:8000) здесь НЕ проксируется — остаётся localhost-only.

rent.example.com {            # <-- заменить на свой сабдомен

    encode zstd gzip

    # Статика и фото — отдаёт сам Caddy с диска, мимо Python (быстро, far-future cache).
    handle_path /static/* {
        root * /opt/otz/src/site/static     # <-- путь к static на VPS
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }
    handle_path /photos/* {
        # photos_root = where the pipeline downloads inbound photos. public_photo_url emits
        # /photos/<relpath-under-this-root>, so this MUST equal SITE_PHOTOS_ROOT. Jailed here
        # (data/inbound) — NOT /opt/otz — so .env / otz.db can never be served via /photos.
        root * /opt/otz/data/inbound
        file_server
        header Cache-Control "public, max-age=604800"
    }

    # Всё остальное — в публичное FastAPI-приложение (otz-site.service).
    handle {
        reverse_proxy 127.0.0.1:8001
    }

    # Базовые security-заголовки.
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        # CSP: 'unsafe-inline' is required by the design's inline style="" attrs + one inline
        # onchange; jsdelivr serves Leaflet (script+css), https:/data: serve OSM tiles + marker
        # icons + the SVG favicon; everything else is same-origin. frame-ancestors/base-uri/
        # form-action add clickjacking/base-tag/form-hijack defense.
        # Follow-up (verify against the live site): relocate the one inline onchange into
        # filters.js so script-src can drop 'unsafe-inline'.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    log {
        output file /var/log/otz/caddy-site.log
    }
}
